{
  "name": "dsh-session-terminal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pick the agent for a new workspace session: DSH chat, CodeBuddy, Claude Code, or any command, running in a real terminal (cmd / bash / PowerShell) that pops out fullscreen on the right.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    },
    "manifestVersion": 1
  },
  "icon": "./icon.svg"
}
